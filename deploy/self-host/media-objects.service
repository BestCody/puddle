[Unit]
Description=Remove deleted Puddle media objects
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/puddle
ExecStart=/usr/bin/docker compose --env-file .env.selfhost -f deploy/self-host/compose.yaml exec -T app node scripts/self-host-cleanup-media-objects.mjs
TimeoutStartSec=20min
