[Unit]
Description=Remove abandoned and deleted Puddle media rows
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/puddle
ExecStart=/usr/bin/docker compose --env-file .env.selfhost -f deploy/self-host/compose.yaml exec -T app node scripts/self-host-cleanup-orphaned-media.mjs
TimeoutStartSec=20min
