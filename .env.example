NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
SUPABASE_SECRET_KEY=YOUR_SERVER_ONLY_SECRET_KEY

# Location-first is the production default. Set true only for a temporary rollback
# or when running the preserved legacy regression suite.
PUDDLE_LEGACY_SYSTEMS_ENABLED=false

# Static worldwide catalogue and managed open-photo cache.
# Use an R2 custom domain in production; do not use the rate-limited r2.dev endpoint.
NEXT_PUBLIC_CATALOGUE_ASSET_BASE_URL=https://places-assets.example.com
STATIC_CATALOGUE_BASE_URL=https://places-assets.example.com
STATIC_CATALOGUE_DISCOVERY_LIMIT=96
STATIC_CATALOGUE_MAX_TILES=64
STATIC_CATALOGUE_TILE_CONCURRENCY=6
STATIC_CATALOGUE_ZOOM=10
DISCOVERY_ANALYTICS_SAMPLE_RATE=0.10
# Separate random server-only secret used to sign tile-specific static card references.
STATIC_CATALOGUE_ACTION_SECRET=REPLACE_WITH_32_OR_MORE_RANDOM_BYTES
STATIC_CATALOGUE_REF_TTL_SECONDS=86400
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=https://places-assets.example.com
R2_UPLOAD_CONCURRENCY=4
R2_DELETE_CONCURRENCY=6
R2_RELEASES_TO_KEEP=2
STATIC_MEDIA_SYNC_LIMIT=250
STATIC_LOCATION_CLEANUP_LIMIT=500

# Google Places UI Kit. Only stable verified Place IDs are persisted.
# Google photo bytes, photo names, and photo URLs must never be cached in R2 or Supabase.
NEXT_PUBLIC_GOOGLE_PLACES_UI_KIT_ENABLED=true
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_MATCH_LIMIT=100
GOOGLE_PLACE_MATCH_MIN_SCORE=0.86
GOOGLE_PLACE_MATCH_TIMEOUT_MS=12000
GOOGLE_PLACE_MATCH_DELAY_MS=250

# Worldwide city search and reverse geocoding. The default adapter expects Geoapify.
# Keep the API key server-only.
GEOCODING_PROVIDER_URL=https://api.geoapify.com/v1/geocode
GEOCODING_API_KEY=

# Optional comma-separated extra HTTPS image hosts approved by provider agreements.
# The hostname from NEXT_PUBLIC_SUPABASE_URL and the R2 public base URL are added
# automatically for Puddle-managed photos.
LOCATION_PHOTO_ALLOWED_HOSTS=
# Optional default manifest path for npm run locations:photos.
LOCATION_PHOTO_MANIFEST=
# Server-only Mapillary token used by the open photo enrichment worker.
MAPILLARY_ACCESS_TOKEN=
OPEN_PHOTO_IMPORT_LIMIT=200
OPEN_PHOTO_MIN_SCORE=0.76
OPEN_PHOTO_REQUEST_TIMEOUT_MS=12000
OPEN_PHOTO_TARGET_BYTES=45000
OPEN_PHOTO_HARD_MAX_BYTES=60000
# Keep Wikimedia traffic polite and retry stale provider assets before marking a failure.
OPEN_PHOTO_WIKIMEDIA_MIN_INTERVAL_MS=1100
OPEN_PHOTO_MAX_CANDIDATES_PER_PROVIDER=3
# A timed-out database claim is retried with progressively smaller batches down to this size.
OPEN_PHOTO_CLAIM_MIN_BATCH_SIZE=1
# Progressive enrichment drains many small committed batches and resumes on the next run.
PHOTO_ENRICH_BATCH_SIZE=100
PHOTO_ENRICH_MAX_BATCHES=50
PHOTO_ENRICH_MAX_RUNTIME_MINUTES=105

# Optional bearer token for protected worker routes.
CRON_SECRET=

# Legacy rollback only: Stage 5 Stripe Connect and Checkout.
# These values are ignored by the active location-first product while
# PUDDLE_LEGACY_SYSTEMS_ENABLED=false.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_COUNTRY=CA
STRIPE_CHECKOUT_MINUTES=30
STRIPE_API_VERSION=2026-02-25.clover

# Legacy rollback only: Ed25519 ticket keys.
TICKET_SIGNING_PRIVATE_KEY_BASE64=
TICKET_SIGNING_PUBLIC_KEY_BASE64=
TICKET_TOKEN_ISSUER=puddle.you

# Local recommendation embeddings remain active without external AI API keys.
# Hashing embeddings work without a model server. Set ollama to use a self-hosted embedding model.
LOCAL_AI_EMBEDDING_PROVIDER=hashing
LOCAL_AI_EMBEDDING_MODEL=embeddinggemma
LOCAL_AI_EMBEDDING_MODEL_VERSION=embeddinggemma
LOCAL_AI_EMBEDDING_DIMENSIONS=768

# A self-hosted Ollama-compatible endpoint is optional for stronger embeddings.
# Legacy creator-writing routes remain disabled unless the rollback flag is enabled.
LOCAL_AI_BASE_URL=http://127.0.0.1:11434
LOCAL_AI_GENERATION_MODEL=gemma3:4b
LOCAL_AI_GENERATION_MODEL_VERSION=gemma3:4b
LOCAL_AI_TIMEOUT_MS=45000
EMBEDDING_BATCH_SIZE=25
EMBEDDING_MAX_BATCHES=10

# Security and location-moderation controls remain active.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAME=
TURNSTILE_REQUIRED=true
SECURITY_HASH_SECRET=REPLACE_WITH_32_OR_MORE_RANDOM_BYTES
CORS_ALLOWED_ORIGINS=
RATE_LIMIT_FAIL_OPEN=false
MALWARE_SCANNER_ENDPOINT=
MALWARE_SCANNER_TOKEN=
MALWARE_SCANNER_SIGNING_SECRET=
MALWARE_SCANNER_TIMEOUT_MS=20000
MALWARE_SCAN_ALL_UPLOADS=false
MEDIA_SCAN_BATCH_SIZE=25
MODERATION_BULK_BATCH_SIZE=25
