NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
SUPABASE_SECRET_KEY=YOUR_SERVER_ONLY_SECRET_KEY

# Static worldwide catalogue and managed open-photo cache.
# Production uses a private Backblaze B2 bucket. No B2 credential is public.
STATIC_CATALOGUE_BASE_URL=https://f005.backblazeb2.com/file/puddle-assets
B2_DOWNLOAD_BASE_URL=https://f005.backblazeb2.com/file/puddle-assets
B2_BUCKET=puddle-assets
B2_BUCKET_ID=
B2_DOWNLOAD_KEY_ID=
B2_DOWNLOAD_APPLICATION_KEY=
B2_DOWNLOAD_TOKEN_TTL_SECONDS=14400
STATIC_CATALOGUE_DISCOVERY_LIMIT=96
STATIC_CATALOGUE_MAX_TILES=64
STATIC_CATALOGUE_TILE_CONCURRENCY=6
STATIC_CATALOGUE_ZOOM=10
DISCOVERY_ANALYTICS_SAMPLE_RATE=0.10
STATIC_CATALOGUE_ACTION_SECRET=REPLACE_WITH_32_OR_MORE_RANDOM_BYTES
STATIC_CATALOGUE_REF_TTL_SECONDS=86400

# Publisher and cleanup credentials. Keep these in GitHub Actions, not browser code.
B2_S3_ENDPOINT=https://s3.us-east-005.backblazeb2.com
B2_REGION=us-east-005
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_UPLOAD_CONCURRENCY=4
B2_DELETE_CONCURRENCY=6
B2_RELEASES_TO_KEEP=2
STATIC_MEDIA_SYNC_LIMIT=250
STATIC_LOCATION_CLEANUP_LIMIT=500

# Google Places UI Kit. Only stable verified Place IDs are persisted.
# Google photo bytes, photo names, and photo URLs must never be cached in B2 or Supabase.
NEXT_PUBLIC_GOOGLE_PLACES_UI_KIT_ENABLED=true
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_MATCH_LIMIT=100
GOOGLE_PLACE_MATCH_MIN_SCORE=0.86
GOOGLE_PLACE_MATCH_TIMEOUT_MS=12000
GOOGLE_PLACE_MATCH_DELAY_MS=250

# Worldwide city search and reverse geocoding. Keep the API key server-only.
GEOCODING_PROVIDER_URL=https://api.geoapify.com/v1/geocode
GEOCODING_API_KEY=

# Optional comma-separated HTTPS image hosts approved by provider agreements.
LOCATION_PHOTO_ALLOWED_HOSTS=
LOCATION_PHOTO_MANIFEST=
MAPILLARY_ACCESS_TOKEN=
OPEN_PHOTO_IMPORT_LIMIT=200
OPEN_PHOTO_MIN_SCORE=0.76
OPEN_PHOTO_REQUEST_TIMEOUT_MS=12000
OPEN_PHOTO_TARGET_BYTES=45000
OPEN_PHOTO_HARD_MAX_BYTES=60000
OPEN_PHOTO_WIKIMEDIA_MIN_INTERVAL_MS=1100
OPEN_PHOTO_MAX_CANDIDATES_PER_PROVIDER=3
OPEN_PHOTO_CLAIM_MIN_BATCH_SIZE=1
PHOTO_ENRICH_BATCH_SIZE=100
PHOTO_ENRICH_MAX_BATCHES=50
PHOTO_ENRICH_MAX_RUNTIME_MINUTES=105

# Optional bearer token for protected worker routes.
CRON_SECRET=

# Security and location-moderation controls.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAME=
TURNSTILE_REQUIRED=true
SECURITY_HASH_SECRET=REPLACE_WITH_32_OR_MORE_RANDOM_BYTES
CORS_ALLOWED_ORIGINS=
RATE_LIMIT_FAIL_OPEN=false
MALWARE_SCANNER_ENDPOINT=
MALWARE_SCANNER_TOKEN=
MALWARE_SCANNER_SIGNING_SECRET=
MALWARE_SCANNER_TIMEOUT_MS=20000
MALWARE_SCAN_ALL_UPLOADS=false
MEDIA_SCAN_BATCH_SIZE=25
MODERATION_BULK_BATCH_SIZE=25
