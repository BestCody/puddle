NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
SUPABASE_SECRET_KEY=YOUR_SERVER_ONLY_SECRET_KEY

# Paid Tinder-tier membership. Keep Stripe secrets server-only.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_TINDER_PRICE_ID=

# Discovery analytics sampling.
DISCOVERY_ANALYTICS_SAMPLE_RATE=0.10

# Global canonical location serving. Enable only after an index has been built and validated.
GLOBAL_LOCATION_SEARCH_ENABLED=false
GLOBAL_LOCATION_FALLBACK_TO_SUPABASE=true
GLOBAL_LOCATION_SEARCH_URL=
GLOBAL_LOCATION_SEARCH_INDEX=locations-active
GLOBAL_LOCATION_CANDIDATE_LIMIT=500
GLOBAL_LOCATION_SEARCH_TIMEOUT_MS=5000
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
OPENSEARCH_BEARER_TOKEN=

# Backblaze B2 canonical data/media storage.
# First production activation reuses the historical puddle-assets bucket and credentials.
# The scoped B2_DATA_* / B2_MEDIA_* variables take precedence when configured later.
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET=puddle-assets
B2_S3_ENDPOINT=https://s3.us-east-005.backblazeb2.com
B2_REGION=us-east-005
B2_DOWNLOAD_BASE_URL=https://f005.backblazeb2.com/file/puddle-assets

# Optional scoped data credentials. Leave empty to fall back to B2_KEY_ID/B2_APPLICATION_KEY/B2_BUCKET.
B2_DATA_APPLICATION_KEY_ID=
B2_DATA_APPLICATION_KEY=
B2_DATA_BUCKET_ID=
B2_DATA_BUCKET_NAME=puddle-assets
B2_DATA_S3_ENDPOINT=https://s3.us-east-005.backblazeb2.com
B2_DATA_S3_REGION=us-east-005
B2_DATA_PREFIX=data

# Optional scoped media credentials. Leave empty to fall back to the historical B2 credentials.
B2_MEDIA_APPLICATION_KEY_ID=
B2_MEDIA_APPLICATION_KEY=
B2_MEDIA_BUCKET_ID=
B2_MEDIA_BUCKET_NAME=puddle-assets
B2_MEDIA_S3_ENDPOINT=https://s3.us-east-005.backblazeb2.com
# Use the direct B2 base until an application-owned CDN/custom domain is provisioned.
B2_MEDIA_PUBLIC_BASE_URL=https://f005.backblazeb2.com/file/puddle-assets
B2_MEDIA_OPEN_PHOTO_PREFIX=media/photos/by-sha256
B2_MEDIA_MIGRATION_CONCURRENCY=16

# Bulk global location sources.
OVERTURE_RELEASE=latest
OVERTURE_MIRROR_WORKERS=8
# Historical FSQ OS connection remains supported. Prefer this if the existing secret still works.
FSQ_OS_CONNECTION_SQL=
# Newer FSQ Iceberg connection is an alternative, not a migration prerequisite.
FSQ_ICEBERG_TOKEN=
FSQ_ICEBERG_ENDPOINT=https://h3-hub-foursquare.acryl.io/gms/iceberg/
FSQ_ICEBERG_CATALOG=open_h3
FSQ_ICEBERG_TABLE=
FSQ_ICEBERG_DELTA_TABLE=
FSQ_RELEASE_LABEL=
GLOBAL_LOCATION_SNAPSHOT=
GLOBAL_BOOTSTRAP_B2_PREFIX=data/snapshots/bootstrap/current

# Google Places UI Kit and server-side place/photo lookup.
# Only stable verified Place IDs are persisted; Google photo bytes and resource URLs are not stored in B2.
NEXT_PUBLIC_GOOGLE_PLACES_UI_KIT_ENABLED=true
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_MATCH_LIMIT=100
GOOGLE_PLACE_MATCH_MIN_SCORE=0.86
GOOGLE_PLACE_MATCH_TIMEOUT_MS=12000
GOOGLE_PLACE_MATCH_DELAY_MS=250

# Worldwide city search and reverse geocoding. Keep the API key server-only.
GEOCODING_PROVIDER_URL=https://api.geoapify.com/v1/geocode
GEOCODING_API_KEY=

# Licensed location-photo enrichment. New accepted photos are stored in B2, never Supabase Storage.
LOCATION_PHOTO_ALLOWED_HOSTS=media.puddle.app,f005.backblazeb2.com
LOCATION_PHOTO_MANIFEST=
MAPILLARY_ACCESS_TOKEN=
KARTAVIEW_ACCESS_TOKEN=
KARTAVIEW_REQUESTS_PER_HOUR=1000
KARTAVIEW_MAX_CONCURRENCY=4
WIKIMEDIA_ACCESS_TOKEN=
WIKIMEDIA_USER_AGENT=Puddle/1.0 global location photo indexer (contact via configured site URL)
WIKIMEDIA_REQUESTS_PER_MINUTE=200
WIKIMEDIA_MAX_CONCURRENCY=3
MAPILLARY_TILE_CONCURRENCY=96
GLOBAL_PHOTO_DOWNLOAD_CONCURRENCY=96
GLOBAL_PHOTO_MATERIALIZE_LIMIT=10000
OPEN_PHOTO_IMPORT_LIMIT=200
OPEN_PHOTO_MIN_SCORE=0.76
OPEN_PHOTO_REQUEST_TIMEOUT_MS=12000
OPEN_PHOTO_TARGET_BYTES=45000
OPEN_PHOTO_HARD_MAX_BYTES=60000
OPEN_PHOTO_WIKIMEDIA_MIN_INTERVAL_MS=300
OPEN_PHOTO_WIKIMEDIA_MAX_CONCURRENCY=3
OPEN_PHOTO_MAPILLARY_MAX_CONCURRENCY=32
OPEN_PHOTO_KARTAVIEW_MIN_INTERVAL_MS=3600
OPEN_PHOTO_LOCATION_CONCURRENCY=100
OPEN_PHOTO_MAX_CANDIDATES_PER_PROVIDER=3
OPEN_PHOTO_CLAIM_MIN_BATCH_SIZE=1
PHOTO_ENRICH_BATCH_SIZE=100
PHOTO_ENRICH_MAX_BATCHES=50
PHOTO_ENRICH_MAX_RUNTIME_MINUTES=105

# Legacy Supabase photo bucket is read only during migration/recovery.
OPEN_PHOTO_SUPABASE_BUCKET=puddle-public-media

# Optional bearer token for protected worker routes.
CRON_SECRET=

# Security and location-moderation controls.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAME=
TURNSTILE_REQUIRED=true
SECURITY_HASH_SECRET=REPLACE_WITH_32_OR_MORE_RANDOM_BYTES
CORS_ALLOWED_ORIGINS=
RATE_LIMIT_FAIL_OPEN=false
MALWARE_SCANNER_ENDPOINT=
MALWARE_SCANNER_TOKEN=
MALWARE_SCANNER_SIGNING_SECRET=
MALWARE_SCANNER_TIMEOUT_MS=20000
MALWARE_SCAN_ALL_UPLOADS=false
MEDIA_SCAN_BATCH_SIZE=25
MODERATION_BULK_BATCH_SIZE=25
