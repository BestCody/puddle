NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
SUPABASE_SECRET_KEY=YOUR_SERVER_ONLY_SECRET_KEY

# Paid Tinder-tier membership. Keep Stripe secrets server-only.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_TINDER_PRICE_ID=

DISCOVERY_ANALYTICS_SAMPLE_RATE=0.10

# Global canonical location serving: immutable private-B2 shards selected by active.json.
# Search failures never fall back to Supabase/Postgres.
GLOBAL_LOCATION_SEARCH_MANIFEST_KEY=data/search/active.json
GLOBAL_LOCATION_CANDIDATE_LIMIT=500
GLOBAL_LOCATION_SEARCH_TIMEOUT_MS=5000
GLOBAL_LOCATION_MANIFEST_TTL_MS=60000
GLOBAL_LOCATION_CACHE_BYTES=67108864
GLOBAL_LOCATION_MAX_RADIUS_KM=100
GLOBAL_LOCATION_MAX_DIRECTORY_TILES=64
GLOBAL_LOCATION_MAX_SHARDS=128
GLOBAL_LOCATION_MAX_OBJECT_BYTES=16777216
GLOBAL_LOCATION_MAX_DECODED_OBJECT_BYTES=67108864
GLOBAL_LOCATION_MAX_COMPRESSED_BYTES=16777216
GLOBAL_LOCATION_MAX_CANDIDATES=150000
GLOBAL_LOCATION_FETCH_CONCURRENCY=8

# Backblaze B2 canonical data/media storage.
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET=puddle-assets
B2_S3_ENDPOINT=https://s3.us-east-005.backblazeb2.com
B2_REGION=us-east-005
B2_DATA_APPLICATION_KEY_ID=
B2_DATA_APPLICATION_KEY=
B2_DATA_BUCKET_ID=
B2_DATA_BUCKET_NAME=puddle-assets
B2_DATA_S3_ENDPOINT=https://s3.us-east-005.backblazeb2.com
B2_DATA_S3_REGION=us-east-005
B2_DATA_PREFIX=data
B2_MEDIA_APPLICATION_KEY_ID=
B2_MEDIA_APPLICATION_KEY=
B2_MEDIA_BUCKET_ID=
B2_MEDIA_BUCKET_NAME=puddle-assets
B2_MEDIA_S3_ENDPOINT=https://s3.us-east-005.backblazeb2.com
B2_MEDIA_OPEN_PHOTO_PREFIX=media/photos/by-sha256

# Bulk global location sources.
OVERTURE_RELEASE=latest
OVERTURE_MIRROR_WORKERS=8
FSQ_OS_CONNECTION_SQL=
FSQ_ICEBERG_TOKEN=
FSQ_ICEBERG_ENDPOINT=https://h3-hub-foursquare.acryl.io/gms/iceberg/
FSQ_ICEBERG_CATALOG=open_h3
FSQ_ICEBERG_TABLE=
FSQ_ICEBERG_DELTA_TABLE=
FSQ_RELEASE_LABEL=
GLOBAL_LOCATION_SNAPSHOT=
GLOBAL_BOOTSTRAP_B2_PREFIX=data/snapshots/bootstrap/current

# Offline B2 search snapshot tuning.
GLOBAL_LOCATION_BUILD_THREADS=8
GLOBAL_LOCATION_H3_ROOT_RESOLUTION=5
GLOBAL_LOCATION_H3_MAX_RESOLUTION=10
GLOBAL_LOCATION_SHARD_TARGET_CANDIDATES=6000
GLOBAL_LOCATION_SHARD_HARD_CANDIDATES=20000
GLOBAL_LOCATION_SHARD_TARGET_BYTES=786432
GLOBAL_LOCATION_SHARD_HARD_BYTES=2097152
GLOBAL_LOCATION_DIRECTORY_DEGREES=1

NEXT_PUBLIC_GOOGLE_PLACES_UI_KIT_ENABLED=true
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_MATCH_LIMIT=100
GOOGLE_PLACE_MATCH_MIN_SCORE=0.86
GOOGLE_PLACE_MATCH_TIMEOUT_MS=12000
GOOGLE_PLACE_MATCH_DELAY_MS=250

GEOCODING_PROVIDER_URL=https://api.geoapify.com/v1/geocode
GEOCODING_API_KEY=

LOCATION_PHOTO_ALLOWED_HOSTS=
LOCATION_PHOTO_MANIFEST=
