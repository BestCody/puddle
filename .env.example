NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Self-hosted reverse proxy only. Set these on the target machine.
PUDDLE_DOMAIN=
SUPABASE_DOMAIN=
ACME_EMAIL=
PUDDLE_REGION=local
# On the Contabo host, use a verified data directory on a filesystem with enough usable capacity.
# A separate mounted volume is optional; do not assume every VPS has one.
PUDDLE_OBJECT_DATA_DIR=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=puddle-assets
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
PUDDLE_DATA_PREFIX=data
PUDDLE_OPEN_PHOTO_PREFIX=media/photos/by-sha256
NEXT_PUBLIC_SUPABASE_URL=https://api.YOUR_DOMAIN
SUPABASE_INTERNAL_URL=http://puddle-supabase-gateway:8000
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
SUPABASE_SECRET_KEY=YOUR_SERVER_ONLY_SECRET_KEY

# Paid Tinder-tier membership. Keep Stripe secrets server-only.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_TINDER_PRICE_ID=

# Discovery analytics sampling.
DISCOVERY_ANALYTICS_SAMPLE_RATE=0.10

# Global canonical location serving.
# Private S3-compatible shards are selected by data/search/active.json.
# Search backend failures never fail over to Supabase/Postgres.
GLOBAL_LOCATION_SEARCH_MANIFEST_KEY=data/search/active.json
GLOBAL_LOCATION_CANDIDATE_LIMIT=500
GLOBAL_LOCATION_SEARCH_TIMEOUT_MS=5000
GLOBAL_LOCATION_MANIFEST_TTL_MS=60000
GLOBAL_LOCATION_CACHE_BYTES=67108864
GLOBAL_LOCATION_MAX_RADIUS_KM=100
GLOBAL_LOCATION_MAX_DIRECTORY_TILES=64
GLOBAL_LOCATION_MAX_SHARDS=128
GLOBAL_LOCATION_MAX_OBJECT_BYTES=16777216
GLOBAL_LOCATION_MAX_DECODED_OBJECT_BYTES=67108864
GLOBAL_LOCATION_MAX_COMPRESSED_BYTES=16777216
GLOBAL_LOCATION_MAX_CANDIDATES=150000
GLOBAL_LOCATION_FETCH_CONCURRENCY=8
GLOBAL_LOCATION_PHOTO_OVERLAY_ACTIVE_KEY=data/search/photo-overlay-v1/active.json
GLOBAL_LOCATION_PHOTO_OVERLAY_TTL_MS=60000
GLOBAL_LOCATION_PHOTO_OVERLAY_MAX_BYTES=12582912
GLOBAL_LOCATION_PHOTO_OVERLAY_MAX_DECODED_BYTES=67108864


# Bulk global location sources.
OVERTURE_RELEASE=latest
OVERTURE_MIRROR_WORKERS=8
# Historical FSQ OS connection remains supported. Prefer this if the existing secret still works.
FSQ_OS_CONNECTION_SQL=
# Newer FSQ Iceberg connection is an alternative, not a migration prerequisite.
FSQ_ICEBERG_TOKEN=
FSQ_ICEBERG_ENDPOINT=https://h3-hub-foursquare.acryl.io/gms/iceberg/
FSQ_ICEBERG_CATALOG=open_h3
FSQ_ICEBERG_TABLE=
FSQ_ICEBERG_DELTA_TABLE=
FSQ_RELEASE_LABEL=
GLOBAL_LOCATION_SNAPSHOT=
GLOBAL_BOOTSTRAP_PREFIX=data/snapshots/bootstrap/current

# Search snapshot build tuning. These are offline-only and do not affect request hot paths.
GLOBAL_LOCATION_BUILD_THREADS=8
GLOBAL_LOCATION_H3_ROOT_RESOLUTION=5
GLOBAL_LOCATION_H3_MAX_RESOLUTION=10
GLOBAL_LOCATION_SHARD_TARGET_CANDIDATES=6000
GLOBAL_LOCATION_SHARD_HARD_CANDIDATES=20000
GLOBAL_LOCATION_SHARD_TARGET_BYTES=786432
GLOBAL_LOCATION_SHARD_HARD_BYTES=2097152
GLOBAL_LOCATION_DIRECTORY_DEGREES=1

# Google Places UI Kit and server-side place/photo lookup.
# Only stable verified Place IDs are persisted; Google photo bytes and resource URLs are not stored in the canonical object store.
NEXT_PUBLIC_GOOGLE_PLACES_UI_KIT_ENABLED=true
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_MATCH_LIMIT=100
GOOGLE_PLACE_MATCH_MIN_SCORE=0.86
GOOGLE_PLACE_MATCH_TIMEOUT_MS=12000
GOOGLE_PLACE_MATCH_DELAY_MS=250

# Worldwide city search and reverse geocoding. Keep the API key server-only.
GEOCODING_PROVIDER_URL=https://api.geoapify.com/v1/geocode
GEOCODING_API_KEY=

# Licensed location-photo enrichment. New accepted photos are stored in the private object store, never Supabase Storage.
# Direct remote-photo proxy hosts are opt-in only; the configured Supabase project host is allowed automatically.
LOCATION_PHOTO_ALLOWED_HOSTS=
LOCATION_PHOTO_MANIFEST=
MAPILLARY_ACCESS_TOKEN=
KARTAVIEW_ACCESS_TOKEN=
KARTAVIEW_REQUESTS_PER_HOUR=1000
KARTAVIEW_MAX_CONCURRENCY=4
WIKIMEDIA_ACCESS_TOKEN=
WIKIMEDIA_USER_AGENT=Puddle/1.0 global location photo indexer (contact via configured site URL)
WIKIMEDIA_REQUESTS_PER_MINUTE=200
WIKIMEDIA_MAX_CONCURRENCY=3
MAPILLARY_TILE_CONCURRENCY=96
GLOBAL_PHOTO_DOWNLOAD_CONCURRENCY=96
OPEN_PHOTO_MAX_CANDIDATES_PER_PROVIDER=3

# Optional bearer token for protected worker routes.
CRON_SECRET=

# Security and location-moderation controls.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAME=
TURNSTILE_REQUIRED=true
SECURITY_HASH_SECRET=REPLACE_WITH_32_OR_MORE_RANDOM_BYTES
CORS_ALLOWED_ORIGINS=
RATE_LIMIT_FAIL_OPEN=false
MALWARE_SCANNER_ENDPOINT=tcp://scanner:3310
MALWARE_SCANNER_TIMEOUT_MS=20000
MALWARE_SCAN_ALL_UPLOADS=true
MEDIA_SCAN_BATCH_SIZE=25
MEDIA_CLEANUP_BATCH_SIZE=25
MODERATION_BULK_BATCH_SIZE=25
INDEXNOW_KEY=54ac80399e6a8b9fd40be2de0db7b9f6
