NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
SUPABASE_SECRET_KEY=YOUR_SERVER_ONLY_SECRET_KEY

# Location-first is the production default. Set true only for a temporary rollback
# or when running the preserved legacy regression suite.
PUDDLE_LEGACY_SYSTEMS_ENABLED=false

# Worldwide city search and reverse geocoding. The default adapter expects Geoapify.
# Keep the API key server-only.
GEOCODING_PROVIDER_URL=https://api.geoapify.com/v1/geocode
GEOCODING_API_KEY=

# Exact comma-separated HTTPS image hosts approved by provider agreements.
# Include YOUR_PROJECT.supabase.co when imported open photos are stored in puddle-public-media.
LOCATION_PHOTO_ALLOWED_HOSTS=
# Optional default manifest path for npm run locations:photos.
LOCATION_PHOTO_MANIFEST=
# Server-only Mapillary token used by the open photo enrichment worker.
MAPILLARY_ACCESS_TOKEN=
OPEN_PHOTO_IMPORT_LIMIT=200
OPEN_PHOTO_MIN_SCORE=0.76

# Overture catalogue refresh worker. User locations queue worldwide regions automatically.
CATALOGUE_REFRESH_REGION_LIMIT=4
CATALOGUE_REFRESH_PLACE_LIMIT=100000
CATALOGUE_REFRESH_PHOTO_LIMIT=200
CATALOGUE_PHOTO_ENRICH=true
# Optional label stored with each successful refresh. The Overture CLI uses its latest release automatically.
OVERTURE_RELEASE=latest

# Optional bearer token for protected worker routes.
CRON_SECRET=

# Legacy rollback only: Stage 5 Stripe Connect and Checkout.
# These values are ignored by the active location-first product while
# PUDDLE_LEGACY_SYSTEMS_ENABLED=false.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_COUNTRY=CA
STRIPE_CHECKOUT_MINUTES=30
STRIPE_API_VERSION=2026-02-25.clover

# Legacy rollback only: Ed25519 ticket keys.
TICKET_SIGNING_PRIVATE_KEY_BASE64=
TICKET_SIGNING_PUBLIC_KEY_BASE64=
TICKET_TOKEN_ISSUER=puddle.you

# Local recommendation embeddings remain active without external AI API keys.
# Hashing embeddings work without a model server. Set ollama to use a self-hosted embedding model.
LOCAL_AI_EMBEDDING_PROVIDER=hashing
LOCAL_AI_EMBEDDING_MODEL=embeddinggemma
LOCAL_AI_EMBEDDING_MODEL_VERSION=embeddinggemma
LOCAL_AI_EMBEDDING_DIMENSIONS=768

# A self-hosted Ollama-compatible endpoint is optional for stronger embeddings.
# Legacy creator-writing routes remain disabled unless the rollback flag is enabled.
LOCAL_AI_BASE_URL=http://127.0.0.1:11434
LOCAL_AI_GENERATION_MODEL=gemma3:4b
LOCAL_AI_GENERATION_MODEL_VERSION=gemma3:4b
LOCAL_AI_TIMEOUT_MS=45000
EMBEDDING_BATCH_SIZE=25
EMBEDDING_MAX_BATCHES=10

# Security and location-moderation controls remain active.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAME=
TURNSTILE_REQUIRED=true
SECURITY_HASH_SECRET=REPLACE_WITH_32_OR_MORE_RANDOM_BYTES
CORS_ALLOWED_ORIGINS=
RATE_LIMIT_FAIL_OPEN=false
MALWARE_SCANNER_ENDPOINT=
MALWARE_SCANNER_TOKEN=
MALWARE_SCANNER_SIGNING_SECRET=
MALWARE_SCANNER_TIMEOUT_MS=20000
MALWARE_SCAN_ALL_UPLOADS=false
MEDIA_SCAN_BATCH_SIZE=25
MODERATION_BULK_BATCH_SIZE=25
