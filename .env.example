NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
SUPABASE_SECRET_KEY=YOUR_SERVER_ONLY_SECRET_KEY

# Paid Tinder-tier membership. Keep Stripe secrets server-only.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_TINDER_PRICE_ID=

# Discovery analytics sampling.
DISCOVERY_ANALYTICS_SAMPLE_RATE=0.10

# Google Places UI Kit and server-side place/photo lookup.
# Only stable verified Place IDs are persisted; Google photo bytes and resource URLs are not stored.
NEXT_PUBLIC_GOOGLE_PLACES_UI_KIT_ENABLED=true
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_MATCH_LIMIT=100
GOOGLE_PLACE_MATCH_MIN_SCORE=0.86
GOOGLE_PLACE_MATCH_TIMEOUT_MS=12000
GOOGLE_PLACE_MATCH_DELAY_MS=250

# Worldwide city search and reverse geocoding. Keep the API key server-only.
GEOCODING_PROVIDER_URL=https://api.geoapify.com/v1/geocode
GEOCODING_API_KEY=

# Open licensed location photos. Approved imports are stored in Supabase public media.
LOCATION_PHOTO_ALLOWED_HOSTS=
LOCATION_PHOTO_MANIFEST=
MAPILLARY_ACCESS_TOKEN=
OPEN_PHOTO_IMPORT_LIMIT=200
OPEN_PHOTO_MIN_SCORE=0.76
OPEN_PHOTO_REQUEST_TIMEOUT_MS=12000
OPEN_PHOTO_TARGET_BYTES=45000
OPEN_PHOTO_HARD_MAX_BYTES=60000
OPEN_PHOTO_WIKIMEDIA_MIN_INTERVAL_MS=1100
OPEN_PHOTO_MAX_CANDIDATES_PER_PROVIDER=3
OPEN_PHOTO_CLAIM_MIN_BATCH_SIZE=1
PHOTO_ENRICH_BATCH_SIZE=100
PHOTO_ENRICH_MAX_BATCHES=50
PHOTO_ENRICH_MAX_RUNTIME_MINUTES=105

# Optional bearer token for protected worker routes.
CRON_SECRET=

# Security and location-moderation controls.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAME=
TURNSTILE_REQUIRED=true
SECURITY_HASH_SECRET=REPLACE_WITH_32_OR_MORE_RANDOM_BYTES
CORS_ALLOWED_ORIGINS=
RATE_LIMIT_FAIL_OPEN=false
MALWARE_SCANNER_ENDPOINT=
MALWARE_SCANNER_TOKEN=
MALWARE_SCANNER_SIGNING_SECRET=
MALWARE_SCANNER_TIMEOUT_MS=20000
MALWARE_SCAN_ALL_UPLOADS=false
MEDIA_SCAN_BATCH_SIZE=25
MODERATION_BULK_BATCH_SIZE=25
