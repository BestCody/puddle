# Non-secret production defaults. Secrets remain in Vercel.
# Keep OpenSearch active until the B2 candidate build/validation/parity gate has passed.
GLOBAL_LOCATION_SEARCH_BACKEND=opensearch
GLOBAL_LOCATION_SEARCH_MANIFEST_KEY=data/search/active.json
GLOBAL_LOCATION_CANDIDATE_LIMIT=500
GLOBAL_LOCATION_SEARCH_TIMEOUT_MS=5000
GLOBAL_LOCATION_MANIFEST_TTL_MS=60000
GLOBAL_LOCATION_CACHE_BYTES=67108864
GLOBAL_LOCATION_MAX_RADIUS_KM=100
GLOBAL_LOCATION_MAX_DIRECTORY_TILES=64
GLOBAL_LOCATION_MAX_SHARDS=128
GLOBAL_LOCATION_MAX_OBJECT_BYTES=16777216
GLOBAL_LOCATION_MAX_DECODED_OBJECT_BYTES=67108864
GLOBAL_LOCATION_MAX_COMPRESSED_BYTES=16777216
GLOBAL_LOCATION_MAX_CANDIDATES=150000
GLOBAL_LOCATION_FETCH_CONCURRENCY=8
