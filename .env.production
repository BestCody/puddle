# Non-secret production defaults. Secrets remain in Vercel.
# B2 is the only global-location serving backend; there is no legacy fallback.
GLOBAL_LOCATION_SEARCH_MANIFEST_KEY=data/search/active.json
GLOBAL_LOCATION_CANDIDATE_LIMIT=500
# locationSearchRuntimeConfig enforces a 10s minimum; make the production default explicit.
GLOBAL_LOCATION_SEARCH_TIMEOUT_MS=10000
GLOBAL_LOCATION_MANIFEST_TTL_MS=60000
GLOBAL_LOCATION_CACHE_BYTES=67108864
# Vercel Runtime Cache stores only small B2 search objects. Larger objects bypass it safely.
GLOBAL_LOCATION_RUNTIME_CACHE=1
GLOBAL_LOCATION_RUNTIME_CACHE_MAX_RAW_BYTES=1400000
GLOBAL_LOCATION_RUNTIME_CACHE_ACTIVE_TTL_SECONDS=30
GLOBAL_LOCATION_RUNTIME_CACHE_IMMUTABLE_TTL_SECONDS=2592000
GLOBAL_LOCATION_MAX_RADIUS_KM=100
GLOBAL_LOCATION_MAX_DIRECTORY_TILES=64
GLOBAL_LOCATION_MAX_SHARDS=128
GLOBAL_LOCATION_MAX_OBJECT_BYTES=16777216
GLOBAL_LOCATION_MAX_DECODED_OBJECT_BYTES=67108864
GLOBAL_LOCATION_MAX_COMPRESSED_BYTES=16777216
GLOBAL_LOCATION_MAX_CANDIDATES=150000
# The planner already caps physical objects; one wave of parallel reads avoids 3x B2 round trips in dense cities.
GLOBAL_LOCATION_FETCH_CONCURRENCY=24
