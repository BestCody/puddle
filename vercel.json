{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "fluid": true,
  "buildCommand": "npm run vercel-build",
  "ignoreCommand": "node -e \"/* process.exit(0) */ process.exit(1)\"",
  "regions": [
    "pdx1"
  ],
  "crons": [
    {
      "path": "/api/seo/indexnow",
      "schedule": "0 6 * * *"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "main": true
    }
  }
}
